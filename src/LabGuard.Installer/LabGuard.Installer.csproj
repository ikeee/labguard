<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LabGuard.Installer</RootNamespace>
    <AssemblyName>LabGuard.Installer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>CS0618;CS1591</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>机房管理助手（复刻）安装程序</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LabGuard.Core\LabGuard.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <!-- 安装包体（由 scripts\build-installer.ps1 从 dist 准备到 payload\ 后编译进本 exe） -->
  <ItemGroup>
    <EmbeddedResource Include="payload\**\*" Condition="Exists('payload')">
      <LogicalName>payload/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <!--
    救援工具也内嵌进安装程序：安装时会被放进"系统级备份副本"目录
    %ProgramData%\LabGuard\payload\tools\（只有 SYSTEM/管理员能访问），
    这样即使老师丢了 U 盘，也能在机器上找到彻底卸载/加固脚本；学生（标准用户）看不到、删不掉。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\cleanup-all.ps1">
      <LogicalName>tools/cleanup-all.ps1</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\scripts\harden-service.ps1">
      <LogicalName>tools/harden-service.ps1</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
