<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>LabGuard.Core</RootNamespace>
    <AssemblyName>LabGuard.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>CS0618;CS1591</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>LabGuard核心</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- 程序图标（作者 GitHub 头像）：exe 挂图标走 ApplicationIcon（Directory.Build.props）；
         这里嵌入一份是给运行时代码用（托盘 NotifyIcon 没法自动继承 exe 图标） -->
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Security" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
